# ---------------------------------------------------------------------------
# PLANTILLA. Este fichero SÍ se sube a GitHub, y por eso está vacío de valores.
# ---------------------------------------------------------------------------
# Para usarlo:
#
#   1. Haz una copia con el nombre  .env   (sin el ".example")
#   2. Pega tus claves ahí dentro
#   3. No toques nada más: el ".env" está en el .gitignore, así que no se sube
#      a GitHub ni por error.
#
# En Windows, desde la carpeta del proyecto:
#      copy .env.example .env
#
# Nunca escribas una clave de verdad en ESTE fichero.
# ---------------------------------------------------------------------------


# La única clave que JOKER necesita para funcionar.
# Es gratis y se saca en https://console.groq.com/keys
# Empieza por "gsk_".
GROQ_API_KEY=


# ---------------------------------------------------------------------------
# Lo de abajo es opcional. JOKER arranca perfectamente sin nada de esto.
# ---------------------------------------------------------------------------

# Ponlo a 1 solo si estás buscando un fallo: saca por consola lo que JOKER
# piensa en cada paso. Déjalo vacío para el día a día.
JOKER_DEBUG=

# Solo si algún día quieres probar JOKER contra Claude o Gemini en vez de
# Groq (joker_claude.py / joker_gemini.py). Estas dos son de pago.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
